{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "acme_email": {
      "type": "string",
      "description": "The Let's Encrypt account contact: expiry warnings land here."
    },
    "docker_version": {
      "type": "string",
      "description": "The Docker CE major the docker role pins and holds, as an apt version glob (default 5:29*)."
    },
    "authelia_policy": {
      "type": "string",
      "enum": [
        "one_factor",
        "two_factor"
      ],
      "description": "What Authelia asks of staff: two_factor (default) or one_factor."
    },
    "authelia_smtp_address": {
      "type": "string",
      "description": "SMTP server for Authelia's mails (passkey enrolment); empty: mails go to a file."
    },
    "authelia_smtp_username": {
      "type": "string",
      "description": "SMTP user for Authelia."
    },
    "authelia_smtp_sender": {
      "type": "string",
      "description": "Sender address of Authelia's mails."
    },
    "acme_dns": {
      "type": "string",
      "enum": [
        "",
        "hetzner"
      ],
      "description": "Certificates by DNS-01 instead of HTTP-01, for a server the internet never reaches: the DNS provider (hetzner)."
    },
    "renovate_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "owner/repo of the repos this server's Renovate job keeps up to date; the job runs only where the list is not empty."
    },
    "renovate_schedule": {
      "type": "string",
      "description": "When the Renovate job runs, as a five-field cron spec in the server's time (default weekly: 0 4 * * 1)."
    },
    "renovate_platform": {
      "type": "string",
      "enum": [
        "github",
        "forgejo",
        "gitlab"
      ],
      "description": "Where the repos live: github (default), forgejo or gitlab."
    },
    "renovate_endpoint": {
      "type": "string",
      "description": "With a Forgejo: its API on platform-internal, e.g. http://forgejo:3000/api/v1."
    },
    "renovate_git_url": {
      "type": "string",
      "enum": [
        "default",
        "ssh",
        "endpoint"
      ],
      "description": "How Renovate clones; endpoint with a Forgejo, so it uses the internal address."
    },
    "renovate_host_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matchHost": {
            "type": "string"
          }
        },
        "required": [
          "matchHost"
        ],
        "additionalProperties": {}
      },
      "description": "Renovate hostRules: allowInternal for a Forgejo on platform-internal, credentials for a private registry."
    },
    "vm": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "disk": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "gateway",
        "disk"
      ],
      "additionalProperties": {},
      "description": "target home: the VM kayra provision builds — fixed address (CIDR), gateway, disk size."
    },
    "forgejo_config": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secret": {
                "type": "string"
              }
            },
            "required": [
              "user",
              "name",
              "scopes",
              "secret"
            ],
            "additionalProperties": {}
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "email"
            ],
            "additionalProperties": {}
          }
        },
        "orgs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "limited",
                  "private"
                ]
              }
            },
            "required": [
              "name",
              "owner",
              "visibility"
            ],
            "additionalProperties": {}
          }
        },
        "ssh_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "user",
              "title",
              "key"
            ],
            "additionalProperties": {}
          }
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "settings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "collaborators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "string"
                    },
                    "permission": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user",
                    "permission"
                  ],
                  "additionalProperties": {}
                }
              },
              "webhooks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "push_mirror": {
                "type": "string"
              },
              "pull_mirror": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "url",
        "container"
      ],
      "additionalProperties": {},
      "description": "What this server's own Forgejo holds, as code: users, SSH keys, organizations, runners, repos (settings, collaborators, webhooks, mirrors) and the tokens it mints for the platform."
    },
    "compose_stacks": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "stacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dir",
        "stacks"
      ],
      "additionalProperties": {},
      "description": "The server's own compose stacks: their directory on the server and the names under stacks/ to run."
    }
  },
  "additionalProperties": false,
  "title": "vars.yml (kind platform)"
}
