#!/usr/bin/env bash
# Generated by Ansible (backup-check role). Hourly, from backup-check.timer.
#
# Opens a GitHub issue when a repository's newest snapshot is older than
# {{ backup_check.stale_after_hours }} hours, or (with restore_test_max_days) when its last restore
# test failed or is overdue, and closes it once that has passed. GitHub is
# only told about changes, which state/ records. The issue comes from a GitHub
# App, not a personal token: GitHub notifies no one about their own actions.
set -euo pipefail

state=/opt/backup-check/state
repo={{ backup_check.github_repository | quote }}
stale_after=$(( {{ backup_check.stale_after_hours | int }} * 3600 ))

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

github_token() {
    local now header payload jwt installation
    now=$(date +%s)
    header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
    payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) {{ backup_check.github_app_id | quote }} | b64url)
    jwt="${header}.${payload}.$(printf '%s.%s' "$header" "$payload" \
        | openssl dgst -sha256 -sign /opt/backup-check/github-app.pem | b64url)"
    installation=$(github "$jwt" "https://api.github.com/repos/${repo}/installation" | jq -r .id)
    github "$jwt" -X POST "https://api.github.com/app/installations/${installation}/access_tokens" | jq -r .token
}

github() {
    local token="$1"; shift
    curl -fsS -H "Authorization: Bearer ${token}" -H "Accept: application/vnd.github+json" "$@"
}

# A file's Last-Modified as epoch seconds; nothing if the file is missing.
modified() {
    local header status
    header=$(curl -sSI --netrc-file /opt/backup-check/netrc "$1")
    status=$(printf '%s\n' "$header" | head -1 | cut -d' ' -f2)
    case "$status" in
        200) date -d "$(printf '%s\n' "$header" | sed -n 's/^last-modified: *//Ip' | tr -d '\r')" +%s ;;
        404) ;;
        *) echo "$1: HTTP ${status}" >&2; return 1 ;;
    esac
}

# The newest snapshot's upload time; nothing without one. A read-only Storage
# Box sub-account answers no PROPFIND, only Apache's directory listing: sorted
# newest first, then that file's Last-Modified.
newest_snapshot() {
    local url="${1%/}/snapshots/" name
    name=$(curl -fsS --netrc-file /opt/backup-check/netrc "${url}?C=M;O=D" \
        | grep -oE 'href="[0-9a-f]{64}"' | head -1 | cut -d'"' -f2)
    [ -z "$name" ] || modified "${url}${name}"
}

when() { date -d "@$1" '+%Y-%m-%d %H:%M %Z'; }

# One issue per key while its problem lasts; state/<key> holds its number.
open_issue() {
    local key="$1" title="$2" body="$3"
    [ ! -f "${state}/${key}" ] || return 0
    github "$(github_token)" -X POST "https://api.github.com/repos/${repo}/issues" \
        -d "$(jq -n --arg title "$title" --arg body "${body}

cc @${repo%%/*}" '{title: $title, body: $body}')" \
        | jq -r .number > "${state}/${key}"
}

close_issue() {
    local key="$1" comment="$2" token issue
    [ -f "${state}/${key}" ] || return 0
    token=$(github_token)
    issue="https://api.github.com/repos/${repo}/issues/$(cat "${state}/${key}")"
    github "$token" -X POST "${issue}/comments" -d "$(jq -n --arg body "$comment" '{body: $body}')" >/dev/null
    github "$token" -X PATCH "$issue" -d '{"state": "closed", "state_reason": "completed"}' >/dev/null
    rm "${state}/${key}"
}

check_snapshots() {
    local name="$1" url="$2" newest last
    newest=$(newest_snapshot "$url")
    if [ $(( $(date +%s) - ${newest:-0} )) -gt "$stale_after" ]; then
        if [ -n "$newest" ]; then last="The newest snapshot is from $(when "$newest")."; else last="There is no snapshot yet."; fi
        open_issue "$name" "Backup stale: ${name}" "No backup of \`${name}\` has reached its repository for more than {{ backup_check.stale_after_hours }} hours. ${last}

Look at the backup container's log on the source. This issue closes itself when the next snapshot arrives."
    else
        close_issue "$name" "A new snapshot arrived."
    fi
}

# The source uploads restore-test.passed or .failed next to the repository
# after each restore test (restic-backup role).
check_restore_test() {
    local name="$1" url="${2%/}" max_days="$3" passed failed problem last
    passed=$(modified "${url}/restore-test.passed")
    failed=$(modified "${url}/restore-test.failed")
    if [ "${failed:-0}" -gt "${passed:-0}" ]; then
        problem="The last restore test of \`${name}\` failed, at $(when "$failed")."
    elif [ $(( $(date +%s) - ${passed:-0} )) -gt $(( max_days * 86400 )) ]; then
        if [ -n "$passed" ]; then last="The last one passed at $(when "$passed")."; else last="None has passed yet."; fi
        problem="No restore test of \`${name}\` has passed for more than ${max_days} days. ${last}"
    fi
    if [ -n "${problem:-}" ]; then
        open_issue "${name}-restore-test" "Restore test: ${name}" "${problem}

Its log is log/restore-test.log in the backup directory on the source; \`kayra backup test ${name}\` runs one by hand and follows it. This issue closes itself when the next one passes."
    else
        close_issue "${name}-restore-test" "A restore test passed."
    fi
}

{% for repository in backup_check.repositories %}
check_snapshots {{ repository.name | quote }} {{ repository.url | quote }}
{% if repository.restore_test_max_days is defined %}
check_restore_test {{ repository.name | quote }} {{ repository.url | quote }} {{ repository.restore_test_max_days | int }}
{% endif %}
{% endfor %}
