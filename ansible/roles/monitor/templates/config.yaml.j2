# Generated by Ansible (monitor role) from monitor in servers/{{ server }}/vars.yml.
alerting:
  ntfy:
    url: {{ notifier.url | to_json }}
    topic: {{ notifier.topic | to_json }}
    token: "${NTFY_TOKEN}"
    priority: 4
    default-alert:
      failure-threshold: 3
      success-threshold: 2
      send-on-resolved: true
      description: {{ ('seen from ' ~ server) | to_json }}

endpoints:
{% for endpoint in monitor_endpoints %}
  - name: {{ endpoint.name | to_json }}
    group: {{ endpoint.group | to_json }}
    url: {{ endpoint.url | to_json }}
    interval: 1m
{% if not endpoint.redirects %}
    client:
      ignore-redirect: true
{% endif %}
    # As a browser: Authelia answers anything else with 401, not the login.
    headers:
      Accept: text/html
{% if endpoint.health %}
      Authorization: "Bearer ${HEALTH_TOKEN_{{ endpoint.group | upper | replace('-', '_') }}}"
{% endif %}
    conditions: {{ endpoint.conditions | to_json }}
    alerts:
      - type: ntfy
{% endfor %}
