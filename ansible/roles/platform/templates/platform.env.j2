# =============================================================================
# {{ platform_dir }}/.env — generated by Ansible, do not edit on the server.
#
# Compose reads it automatically in {{ platform_dir }}, and COMPOSE_FILE means
# `docker compose <cmd>` there needs no -f flags. App-agnostic: app secrets
# reach the deployer through bin/app-apply, app config lives in
# {{ apps_dir }}/<app>/.env.
# =============================================================================

COMPOSE_PROJECT_NAME=platform
COMPOSE_FILE=docker-compose.yml:docker-compose.ci.yml{{ ':docker-compose.acme-dns.yml' if acme_dns else '' }}
DOMAIN={{ domain }}
AUTH_POLICY={{ authelia_policy }}
APPS_DIR={{ apps_dir }}
DOCKER_GID={{ ansible_facts.getent_group.docker[1] }}
PLATFORM_RENOVATE={{ (renovate_repositories | length > 0) | lower }}
RENOVATE_SCHEDULE={{ renovate_schedule }}
RENOVATE_PLATFORM={{ renovate_platform }}
RENOVATE_ENDPOINT={{ renovate_endpoint }}
RENOVATE_GIT_URL={{ renovate_git_url }}
RENOVATE_GITHUB_COM_TOKEN={{ renovate_github_com_token }}
RENOVATE_HOST_RULES={{ renovate_host_rules | to_json if renovate_host_rules else '' }}
RENOVATE_REPOSITORIES={{ renovate_repositories | to_json }}

WEBHOOKS={{ webhooks | lower }}
DEPLOY_POLL={{ deploy_poll }}
WEBHOOK_SECRET={{ webhook_secret }}
SERVER={{ server }}
NOTIFIER={{ notifier | to_json if notifier else '' }}

# Authelia SMTP. Empty address falls the notifier back to a file — passkey
# enrolment then needs the code read off the server. The password is NOT here:
# it is rendered to authelia/secrets/smtp_password, because an empty
# AUTHELIA_NOTIFIER_SMTP_PASSWORD would make Authelia think SMTP is configured.
AUTHELIA_SMTP_ADDRESS={{ authelia_smtp_address }}
AUTHELIA_SMTP_USERNAME={{ authelia_smtp_username }}
AUTHELIA_SMTP_SENDER={{ authelia_smtp_sender }}
