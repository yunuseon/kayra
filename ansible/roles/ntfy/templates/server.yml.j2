# Generated by Ansible from ntfy in servers/{{ server }}/vars.yml and the
# ntfy_* secrets.
base-url: {{ ntfy.base_url | to_json }}
listen-http: ":80"
behind-proxy: true
cache-file: /var/cache/ntfy/cache.db
auth-file: /var/lib/ntfy/user.db
auth-default-access: deny-all
{% if ntfy.upstream_base_url is defined %}
upstream-base-url: {{ ntfy.upstream_base_url | to_json }}
{% endif %}
auth-users:
{% for name, hash in ntfy_password_hashes.items() %}
  - {{ (name ~ ':' ~ hash ~ ':user') | to_json }}
{% endfor %}
auth-access:
{% for entry in ntfy.access %}
  - {{ (entry.user ~ ':' ~ entry.topic ~ ':' ~ entry.permission) | to_json }}
{% endfor %}
auth-tokens:
{% for name, token in ntfy_tokens.items() %}
  - {{ (name ~ ':' ~ token ~ ':kayra') | to_json }}
{% endfor %}
