{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "default": "platform",
      "description": "Which playbook: platform (default; Traefik, Authelia, the deployer, apps), edge or nas.",
      "type": "string",
      "enum": [
        "platform",
        "edge",
        "nas"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "multipass",
        "hetzner",
        "home"
      ],
      "description": "Where it runs: hetzner, multipass (a local VM) or home (a machine nothing creates)."
    },
    "domain": {
      "description": "The server's domain; platform subdomains and the apps' hang off it.",
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z][a-z0-9-]*$"
    },
    "age_key_file": {
      "description": "The age identity that opens secrets.yml (SOPS); without it, SOPS's own default (SOPS_AGE_KEY_FILE, ~/.config/sops/age/keys.txt).",
      "type": "string"
    },
    "apps": {
      "description": "The apps this server runs (platform only).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "repo": {
            "description": "The app's repository, https://.",
            "type": "string"
          },
          "ref": {
            "description": "The branch to build and deploy (default main).",
            "type": "string"
          },
          "path": {
            "description": "The app's root inside the repository (default .).",
            "default": ".",
            "type": "string"
          },
          "runtime": {
            "description": "The fleet-selected deployment runtime. Compose is the default. Swarm requires explicit host opt-in and applies to new registrations.",
            "type": "string",
            "enum": [
              "compose",
              "swarm"
            ]
          },
          "grants": {
            "description": "Explicit Swarm resources and the operator grant to allow maintenance deployment.",
            "type": "object",
            "properties": {
              "memory_bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "cpu_millicores": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "maintenance": {
                "type": "boolean"
              }
            },
            "required": [
              "memory_bytes",
              "cpu_millicores",
              "maintenance"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "repo"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "target",
    "domain"
  ],
  "additionalProperties": false,
  "title": "server.yml"
}
