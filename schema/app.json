{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "description": "The app's name, as in the server.yml entry.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "compose": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Compose files, relative to the app root, in order. No Traefik label, no platform network: routes say how the app is reached."
    },
    "routes": {
      "description": "How the app is reached: each route a host (and path) to a service's port. Read at the commit being deployed; a new host needs kayra apps.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "description": "Its hostname, <host>.<domain>. The app's hosts are its routes' hosts.",
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "path": {
            "description": "A path prefix: the route answers below it, and beats its host's route without one.",
            "type": "string",
            "pattern": "^\\/[A-Za-z0-9._~%/-]*$"
          },
          "service": {
            "description": "The compose service that answers it.",
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "The port that service listens on, inside its container."
          },
          "rate_limit": {
            "description": "A rate limit on this route, per client address (Traefik's rateLimit).",
            "type": "object",
            "properties": {
              "average": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Requests a client may send per period, on average."
              },
              "period": {
                "description": "The period, such as 10s, 10m or 1h.",
                "type": "string",
                "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
              },
              "burst": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Requests a client may send at once beyond the average."
              }
            },
            "required": [
              "average",
              "period",
              "burst"
            ],
            "additionalProperties": false
          },
          "check": {
            "description": "A path that answers 2xx or 3xx once the app is ready; a deploy waits for it. Without one, the route's own path must answer below 500.",
            "type": "string",
            "pattern": "^\\/[A-Za-z0-9._~%/-]*$"
          }
        },
        "required": [
          "host",
          "service",
          "port"
        ],
        "additionalProperties": false
      }
    },
    "secrets": {
      "description": "Secret keys; their values come from the fleet's secrets.yml, under app_secrets.<app>.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config": {
      "description": "Config keys; their values come from the fleet's apps/<app>.yml.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollout": {
      "description": "Application-owned rollout strategy and capabilities for an explicitly registered Swarm app.",
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "rolling",
            "maintenance"
          ]
        },
        "mixed_version_compatible": {
          "type": "boolean"
        },
        "rollback_compatible": {
          "type": "boolean"
        },
        "services": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "http",
                  "worker",
                  "singleton",
                  "retained-dependency"
                ]
              },
              "overlap": {
                "type": "string",
                "enum": [
                  "allowed",
                  "forbidden",
                  "coordinated"
                ]
              },
              "handoff_check": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
              }
            },
            "required": [
              "role",
              "overlap"
            ],
            "additionalProperties": false
          }
        },
        "migrations": {
          "maxItems": 4096,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
              },
              "service": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
              },
              "command": {
                "minItems": 1,
                "maxItems": 4096,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740
              },
              "recovery": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "replay-safe"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "status-probe"
                      },
                      "command": {
                        "minItems": 1,
                        "maxItems": 4096,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740
                      }
                    },
                    "required": [
                      "kind",
                      "command",
                      "timeout_seconds"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "service",
              "command",
              "timeout_seconds",
              "recovery"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "maxItems": 4096,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
              },
              "service": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
              },
              "command": {
                "minItems": 1,
                "maxItems": 4096,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeout_seconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740
              }
            },
            "required": [
              "id",
              "service",
              "command",
              "timeout_seconds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "strategy",
        "mixed_version_compatible",
        "rollback_compatible",
        "services"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "compose"
  ],
  "additionalProperties": false,
  "title": "app.yml"
}
