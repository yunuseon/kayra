  },
  "dependencies": {
    "@optique/core": "1.3.3",
    "@optique/run": "1.3.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-functional": "10.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
