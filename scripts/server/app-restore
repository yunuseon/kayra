#!/usr/bin/env bash
# =============================================================================
# app-restore <app> [--changed] — an app that was deployed, yet runs no
# container now, deployed again at the release that ran. With --changed, the
# app's registration or .env has just changed (its hosts, after a new domain;
# its config): it is deployed again at that release even if it runs, since a
# running deploy keeps the routes and environment it was started with.
#
# A Docker update or a reboot stops every container; one deployed before the
# platform gave each service a restart policy stays down. The deployer's ctl
# follows the run to its end, so this exits as the run did. An app never
# deployed (no release record) is left alone, and so is one that runs unless
# --changed.
#
# Installed by the platform role at <platform_dir>/bin; run by the app role
# after it registers the app. Run as root. Prints what it did on its last line:
# "never deployed", "runs", "restored <sha>" or "redeployed <sha>".
# =============================================================================
set -euo pipefail

app="${1:?Usage: app-restore <app> [--changed]}"
changed=false
case "${2:-}" in
    "") ;;
    --changed) changed=true ;;
    *) echo "Usage: app-restore <app> [--changed]" >&2; exit 2 ;;
esac
platform_dir="${PLATFORM_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
releases="${platform_dir}/releases/${app}"

# releases/<app>/<UTC time>-<sha>.env, newest last; the deployer writes them.
live=""
if [ -d "$releases" ]; then
    live="$(find "$releases" -maxdepth 1 -name '*.env' -exec basename {} \; | sort | tail -1 \
        | sed -n 's/^[0-9]\{8\}T[0-9]\{6\}Z-\([0-9a-f]\{40\}\)\.env$/\1/p')"
fi
if [ -z "$live" ]; then
    echo "never deployed"
    exit 0
fi

running="$(docker ps -q --filter "label=com.docker.compose.project=${app}" --filter status=running --filter status=restarting)"
if [ -n "$running" ] && [ "$changed" = false ]; then
    echo "runs"
    exit 0
fi

cd "$platform_dir"
docker compose exec -T deployer kayra-deployer ctl deploy "$app" "$live"
if [ -n "$running" ]; then echo "redeployed ${live}"; else echo "restored ${live}"; fi
