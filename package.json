{
  "name": "@yunuseon/kayra",
  "version": "0.7.1",
  "description": "A self-hosted app platform and the CLI that runs it: Traefik, Authelia, Jenkins, a registry and rootless BuildKit per server, set up with OpenTofu and Ansible.",
  "license": "MIT",
  "author": "Yunus Öztürk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunuseon/kayra.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kayra": "bin/kayra.js"
  },
  "files": [
    "bin/",
    "cli/dist/",
    "ansible/",
    "compose/",
    "terraform/",
    "scripts/",
    "cloud-init.yml.tpl",
    "hosts.conf",
    "schema/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "kayra": "node cli/src/main.ts",
    "build": "tsc -p cli/tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p cli --noEmit",
    "lint": "cd cli && eslint --flag unstable_native_nodejs_ts_config .",
    "test": "node --test 'cli/test/**/*.test.ts'",
    "schemas": "node cli/scripts/schemas.ts"
  },
  "dependencies": {
    "@optique/core": "1.3.3",
    "@optique/run": "1.3.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-functional": "10.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "eslint-plugin-functional": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "homepage": "https://github.com/yunuseon/kayra#readme",
  "bugs": {
    "url": "https://github.com/yunuseon/kayra/issues"
  },
  "keywords": [
    "paas",
    "self-hosted",
    "platform",
    "traefik",
    "jenkins",
    "ansible",
    "opentofu",
    "hetzner",
    "docker-compose"
  ]
}
