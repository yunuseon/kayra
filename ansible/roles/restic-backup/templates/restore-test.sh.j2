#!/bin/sh
# Generated by Ansible (restic-backup role). Proves the latest snapshot comes
# back: checks the repository, restores it (or restic_backup.restore_test_paths
# of it) below restore-test/, and has
# pg_restore read every database dump. Deletes the restored copy afterwards.
# Started by cron (restore_test_schedule) or by kayra backup test, which
# follows its log with follow-restore-test.sh. One at a time.
set -eu
. /etc/backup/backup.env

log='{{ restic_backup.dir }}/log'
exec 9>"${log}/restore-test.lock"
if ! flock -n 9; then
    echo "A restore test is already running: ${log}/restore-test.log" >&2
    exit 75
fi
# The log first, then the old status: a follower waits for both to be fresh.
exec >"${log}/restore-test.log" 2>&1
rm -f "${log}/restore-test.status"
# restic leaves progress out without a terminal; every 10 s instead.
export RESTIC_PROGRESS_FPS=0.1

result=failed
finish() {
    status=$?
    echo "$status" > "${log}/restore-test.status"
{% if restic_backup.ssh is defined %}
    # The result, next to the repository, for the backup-check role to read.
    date -u '+%Y-%m-%dT%H:%M:%SZ' > "/tmp/restore-test.${result}"
    echo "put /tmp/restore-test.${result} {{ restic_backup.repository.split(':', 2)[2] }}/restore-test.${result}" \
        | sftp -q -b - backup-target
{% endif %}
}
trap finish EXIT

target='{{ restic_backup.dir }}/restore-test'
find "$target" -mindepth 1 -delete

# Waits out a backup's or prune's lock; reads a twelfth of the data, a
# different one each month, so all of it once a year.
restic check --retry-lock 1h --read-data-subset "$(date +%m | sed 's/^0//')/12"
restic restore latest --host '{{ inventory_hostname }}' --target "$target"{% for path in restic_backup.restore_test_paths | default([]) %} --include {{ path | quote }}{% endfor %}

{% for db in restic_backup.postgres | default([]) %}
pg_restore --list "${target}{{ restic_backup.dir }}/dumps/{{ db.name }}.dump" >/dev/null
echo "{{ db.name }}: dump readable"
{% endfor %}
echo "restored $(find "$target" -type f | wc -l) files, $(du -sh "$target" | cut -f1)"
find "$target" -mindepth 1 -delete
echo "restore test passed"
result=passed
