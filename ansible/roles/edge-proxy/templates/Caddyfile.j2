# Generated by Ansible from edge_routes in servers/<server>/vars.yml.
{
	email {{ acme_email }}

	# Avoid QUIC/HTTP3 surprises on corporate networks.
	servers {
		protocols h1 h2
	}
}
{% for route in edge_routes %}

{{ route.subdomains | map('regex_replace', '$', '.' ~ domain) | join(',\n') }} {
	encode zstd gzip
{% if route.forwarded_headers | default(false) %}
	reverse_proxy {{ route.upstream }} {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Port 443
	}
{% else %}
	reverse_proxy {{ route.upstream }}
{% endif %}
}
{% endfor %}
