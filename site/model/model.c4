model {
  operator = person 'Operator' {
    description 'Runs the fleet: its servers, their settings and secrets'
  }
  developer = person 'App developer' {
    description 'Owns an app repository; pushes to deploy'
  }
  visitor = person 'Visitor' {
    description "Uses an app in the browser"
  }

  fleet = external 'Fleet repository' {
    description 'servers/<name>/: server.yml, vars.yml, secrets.yml (SOPS), terraform/; package.json pins kayra'
  }
  appRepo = external 'App repository' {
    technology 'GitHub or Forgejo'
    description 'app.yml and Dockerfiles: data, no pipeline'
  }
  hetzner = external 'Machine provider' {
    technology 'Hetzner Cloud; Multipass or a machine at home'
    description 'Where servers come from; also DNS for DNS-01 certificates'
  }
  letsencrypt = external 'Certificate authority' {
    technology "Let's Encrypt"
    description 'Certificates by HTTP-01, or DNS-01 where the internet cannot reach'
  }
  localProgram = tool 'Local program' {
    description 'A script or client on the operator machine, authenticated by the private discovery token'
  }
  agent = tool 'Agent' {
    description 'An AI agent such as Claude Code, in the fleet, through kayra mcp or the command line'
    technology 'Claude Code'
  }
  kayra = tool 'Local kayra' {
    description 'One package pinned by the fleet, with a core and four clients on the operator machine'
    technology 'TypeScript, Node 24'

    core = tool 'Core' {
      description 'The operation catalog, fleet validation, pure plans and the interpreter; the only layer running OpenTofu, Ansible and SSH'
      technology 'cli/src/core'
    }
    cli = tool 'Command line' {
      description 'Parses commands, presents the core output and hides secret input; interactive SSH inherits the terminal'
      technology 'Optique, kayra'
    }
    ui = tool 'Browser interface' {
      description 'The web interface, on 127.0.0.1 with a launch token: the same plans and guards, each run live'
      technology 'Preact, kayra serve --ui'
    }
    api = tool 'Local API' {
      description 'The catalog, plans, queries, runs and terminal sessions at /api on 127.0.0.1; compatibility follows the pinned kayra version'
      technology 'HTTP, SSE or NDJSON, kayra serve --api'
    }
    mcp = tool 'MCP server' {
      description 'Every operation as a tool, with progress and cancellation; no password passes through it'
      technology 'MCP over stdio, kayra mcp'
    }
  }

  platform = server 'Platform server' {
    description 'One per customer: kind platform, on Hetzner, at home or a Multipass VM'

    traefik = service 'Edge router' {
      description 'The only way in: routes by hostname, terminates TLS, bridges both networks'
      technology 'Traefik v3'
    }
    socketProxy = service 'Docker API proxy' {
      #internal
      technology 'docker-socket-proxy'
      description "Read-only: the edge router's view of the containers, nothing else of the Docker API"
    }
    authelia = service 'Staff login' {
      #internal
      technology 'Authelia'
      description "Login for the platform's own pages (the runs pages, Traefik's dashboard)"
    }
    deployer = service 'Deployer' {
      #internal
      description 'Holds the Docker socket and the app secrets; queues runs, re-checks what the builder hands over, admits, docker compose up, records releases; never routed'
      technology 'kayra deployer, TypeScript'
    }
    builder = service 'Builder' {
      #internal #untrusted
      technology 'kayra deployer, TypeScript'
      description 'Checks out app code, answers webhooks, shows the runs; no Docker socket, no Docker CLI, no app secrets'
    }
    buildkit = service 'Image builder' {
      #internal #untrusted
      technology 'BuildKit, rootless'
      description "Rootless, AppArmor-confined: runs the app's Dockerfiles, the only app code CI executes"
    }
    registry = store 'Image registry' {
      #internal
      technology 'Distribution (registry:3)'
      description 'Content-addressed app images; no router; GC keeps the last 10 releases'
    }
    appContainers = app 'App containers' {
      #untrusted
      technology 'Docker Compose'
      description "One compose project per app, admitted by the compose policy; on platform-public"
    }
  }

  // Operating the fleet
  operator -> fleet 'edits, through PRs'
  operator -> kayra.cli 'kayra up / setup / apps / app deploy'
  operator -> kayra.ui 'in the browser: the fleet, previews, runs and terminal sessions'
  kayra.cli -> kayra.core 'typed catalog invocations; terminal input and output'
  kayra.ui -> kayra.api 'same-origin cookie: catalog operations and live events'
  localProgram -> kayra.api 'bearer token: /api operations and events'
  kayra.api -> kayra.core 'typed catalog invocations; streamed output, questions and session input'
  operator -> agent 'asks; approves changes to real servers'
  agent -> kayra.mcp 'tool calls over stdio; the typed name before destroying, from the operator'
  kayra.mcp -> kayra.core 'typed catalog invocations; step progress, confirmations asked up front'
  kayra.core -> fleet 'reads and validates'
  kayra.core -> hetzner 'provisions (OpenTofu)'
  kayra.core -> platform 'sets up and operates (Ansible and SSH)'

  // An app's way to production
  developer -> appRepo 'pushes'
  appRepo -> platform.builder 'push webhook, HMAC-signed'
  platform.builder -> platform.deployer 'queues a run'
  platform.deployer -> platform.builder 'asks for a bundle: the commit, its images built'
  platform.builder -> appRepo 'checks out the commit'
  platform.builder -> platform.buildkit 'buildctl over TCP'
  platform.buildkit -> platform.registry 'pushes images'
  platform.deployer -> platform.registry 'pulls images'
  platform.deployer -> platform.appContainers 'admits the compose files, docker compose up'
  platform.deployer -> appRepo 'commit statuses'

  // Traffic
  visitor -> platform.traefik 'HTTPS'
  platform.traefik -> platform.appContainers "the app's hosts (platform-public)"
  platform.traefik -> platform.authelia 'forward auth for platform pages'
  platform.traefik -> platform.builder 'deploy.<domain>: the runs, behind Authelia; /hook/ signed'
  platform.traefik -> letsencrypt 'ACME'
  platform.traefik -> platform.socketProxy 'discovers containers (read-only)'
}
