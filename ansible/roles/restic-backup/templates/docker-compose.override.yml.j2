# Generated by Ansible from restic_backup in servers/<server>/vars.yml.
{% set networks = restic_backup.postgres | default([]) | map(attribute='network') | unique | list %}
services:
  backup:
    volumes:
{% for path in restic_backup.paths %}
      - {{ path }}:{{ path }}:ro
{% endfor %}
{% for dir in ['dumps', 'cache', 'restore-test', 'log'] %}
      - {{ restic_backup.dir }}/{{ dir }}:{{ restic_backup.dir }}/{{ dir }}
{% endfor %}
{% if restic_backup.ssh is defined %}
      - {{ restic_backup.dir }}/ssh:/root/.ssh:ro
{% endif %}
{% if networks %}
    networks:
{% for network in networks %}
      - {{ network }}
{% endfor %}

networks:
{% for network in networks %}
  {{ network }}:
    external: true
{% endfor %}
{% endif %}
