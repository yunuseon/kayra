views {
  view index {
    title 'kayra at a glance'
    description 'The operator uses local kayra to run a fleet; developers push apps, and the platform server builds and serves them.'
    include *
    exclude visitor
    exclude plannedDelivery
  }

  view clients of kayra {
    title 'One core, four clients'
    description 'The command line calls the core directly; the browser and local programs use the API; an agent uses MCP. All operations share the catalog, plans, guards and interpreter.'
    include *
    include operator
    include localProgram
    include agent
    include kayra.core ->
    exclude plannedDelivery
  }

  view platform of platform {
    title 'Inside a platform server'
    description 'Amber: where app code runs. Everything else on platform-internal, which no app container joins; Traefik is the only bridge.'
    include *
    include -> platform.traefik
    style element.tag = #untrusted {
      color amber
    }
  }

  dynamic view deploy {
    title 'From a push to a running app'
    description 'Pipelines are the platform\'s: the app supplies only data, built where it cannot reach the host, and admitted before it starts.'
    autoLayout TopBottom
    developer -> appRepo 'pushes to the app\'s branch'
    appRepo -> platform.builder 'webhook: /hook/<app>, signed'
    platform.builder -> platform.deployer 'queues a run for the app\'s ref'
    platform.deployer -> platform.builder 'prepare that exact commit'
    platform.builder -> platform.buildkit 'buildctl: only images not built yet'
    platform.buildkit -> platform.registry 'pushes <app>/<image>:<content hash>'
    platform.deployer -> platform.registry 'pulls that commit\'s images'
    platform.deployer -> platform.appContainers 'compose policy, then docker compose up --wait'
    visitor -> platform.traefik 'https://www.<domain>'
    platform.traefik -> platform.appContainers 'routes to the new release'
  }
  view deliveryBoundaries of plannedDelivery {
    title 'Proposed application delivery boundaries'
    description 'Target code boundaries inside the existing privileged process, alongside the isolated builder. These components are not all implemented yet.'
    include *
    include kayra.core ->
    style element.tag = #untrusted {
      color amber
    }
  }

  dynamic view proposedDeployment {
    title 'Proposed deployment and promotion'
    description 'Validate untrusted inputs, reserve capacity and persist intent before touching owned workloads. Promotion follows verified readiness.'
    autoLayout TopBottom
    kayra.core -> plannedDelivery.trusted.platform 'registration, grants and deploy request'
    plannedDelivery.trusted.platform -> plannedDelivery.trusted.coordinator 'lifecycle command and grants'
    plannedDelivery.trusted.coordinator -> plannedDelivery.builder 'prepare exact commit as an immutable bundle'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'validate and persist plan, admission and intent'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'run ordered admitted migration steps'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'execute app commands and normalized status probes'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'retain fenced migration evidence or hold for resolution'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'persist bounded HTTP handoff after every migration is applied'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'reconcile plan under absolute deadline'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'update owned services and check readiness'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'promote only after convergence and checks'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.projection 'publish verified active release'
  }

  dynamic view proposedRecovery {
    title 'Proposed restart recovery'
    description 'A new exclusive writer uses persisted intent and runtime observations; ambiguity blocks for an audited decision.'
    autoLayout TopBottom
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'load intent, action identity and original deadline'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'observe existing operation, owned objects and current host authority'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'inspect migration and workload state'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.projection 'publish outcome or intervention required'
    operator -> plannedDelivery.trusted.platform 'resolve a named blocked run and step'
    plannedDelivery.trusted.platform -> plannedDelivery.trusted.coordinator 'validated run/step assertion with transport-derived actor'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'atomically retain audit and parent transition under original deadline'
    operator -> plannedDelivery.trusted.platform 'request separately bounded cleanup for an unfenced attempt'
    plannedDelivery.trusted.platform -> plannedDelivery.trusted.coordinator 'transport-authenticated cleanup identity and reason'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'persist cleanup authority and exact target before effects'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'fence owned attempt; no application Start authority'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'remove exact container and reserve inert name'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'retain cleanup proof without altering original execution evidence'
  }

  dynamic view proposedCancellation {
    title 'Preparation cancellation'
    description 'Known prefix outcomes and fenced jobs permit cancellation; ambiguity stays held without release promotion.'
    autoLayout TopBottom
    operator -> plannedDelivery.trusted.platform 'cancel a named deployment request'
    plannedDelivery.trusted.platform -> plannedDelivery.trusted.coordinator 'validated cancellation command'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'persist intent before stopping future migration starts'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'fence current job under original authority'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'stop exact owned job; run only declared recovery probe'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'record known prefix proof or hold ambiguous outcome'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.projection 'publish cancelling, held or cancelled and unchanged active release'
  }

  dynamic view proposedHandoffExpiry {
    title 'Expired prepared release'
    description 'A ready preparation without an HTTP child fails under its original deadline; applied data and the previous release remain.'
    autoLayout TopBottom
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'read original HTTP deadline and settled migration prefix'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'persist failure and settle ticket before releasing candidate reservation'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.projection 'publish known migration outcomes and preserved active release'
  }

  dynamic view proposedMaintenance {
    title 'Proposed maintenance deployment'
    description 'App declaration and fleet grant permit expected downtime; retained dependencies stay available for migrations.'
    autoLayout TopBottom
    kayra.core -> plannedDelivery.trusted.platform 'maintenance grant and request'
    plannedDelivery.trusted.platform -> plannedDelivery.trusted.coordinator 'authorized maintenance command'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'record plan, admission and intent'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'quiesce consumers; retain dependencies'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'run admitted migrations, then start consumers'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'verify workloads and required checks'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.projection 'report downtime and verified outcome'
  }

  dynamic view proposedRemoval {
    title 'Proposed application removal'
    description 'Removal fences deployments and retains volumes; purge is a separate guarded operation.'
    autoLayout TopBottom
    kayra.core -> plannedDelivery.trusted.platform 'request removal'
    plannedDelivery.trusted.platform -> plannedDelivery.trusted.coordinator 'lifecycle remove command'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'fence deploys and persist removal intent'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.adapter 'settle work and remove owned workloads'
    plannedDelivery.trusted.adapter -> plannedDelivery.workload 'retain volumes and ownership'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.journal 'preserve ownership tombstone'
    plannedDelivery.trusted.coordinator -> plannedDelivery.trusted.projection 'publish removal outcome'
  }
}
