{
  "name": "kayra",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kayra": "src/main.ts"
  },
  "scripts": {
