#!/usr/bin/env bash
# Generated by Ansible (backup-check role). Hourly, from backup-check.timer.
#
# Sends an alert to the notifier (ntfy) when a repository's newest snapshot is
# older than {{ backup_check.stale_after_hours }} hours, or (with restore_test_max_days) when its last
# restore test failed or is overdue, and another once that has passed. Only
# changes are sent, which state/ records.
set -euo pipefail

state=/opt/backup-check/state
stale_after=$(( {{ backup_check.stale_after_hours | int }} * 3600 ))

publish() {
    local title="$1" message="$2" priority="$3" tag="$4"
    curl -fsS -o /dev/null -H "Authorization: Bearer $(cat /opt/backup-check/ntfy-token)" -H "Content-Type: application/json" \
        -d "$(jq -n --arg topic {{ notifier.topic | quote }} --arg title "$title" --arg message "$message" \
            --argjson priority "$priority" --arg tag "$tag" \
            '{topic: $topic, title: $title, message: $message, priority: $priority, tags: [$tag]}')" \
        {{ notifier.url | quote }}
}

# A file's Last-Modified as epoch seconds; nothing if the file is missing.
modified() {
    local header status
    header=$(curl -sSI --netrc-file /opt/backup-check/netrc "$1")
    status=$(printf '%s\n' "$header" | head -1 | cut -d' ' -f2)
    case "$status" in
        200) date -d "$(printf '%s\n' "$header" | sed -n 's/^last-modified: *//Ip' | tr -d '\r')" +%s ;;
        404) ;;
        *) echo "$1: HTTP ${status}" >&2; return 1 ;;
    esac
}

# The newest snapshot's upload time; nothing without one. A read-only Storage
# Box sub-account answers no PROPFIND, only Apache's directory listing: sorted
# newest first, then that file's Last-Modified.
newest_snapshot() {
    local url="${1%/}/snapshots/" name
    name=$(curl -fsS --netrc-file /opt/backup-check/netrc "${url}?C=M;O=D" \
        | grep -oE 'href="[0-9a-f]{64}"' | head -1 | cut -d'"' -f2)
    [ -z "$name" ] || modified "${url}${name}"
}

when() { date -d "@$1" '+%Y-%m-%d %H:%M %Z'; }

# One alert per key while its problem lasts; state/<key> holds its title.
raise_alert() {
    local key="$1" title="$2" message="$3"
    [ ! -f "${state}/${key}" ] || return 0
    publish "$title" "$message" 4 rotating_light
    printf '%s' "$title" > "${state}/${key}"
}

resolve_alert() {
    local key="$1" note="$2"
    [ -f "${state}/${key}" ] || return 0
    publish "Resolved: $(cat "${state}/${key}")" "$note" 3 white_check_mark
    rm "${state}/${key}"
}

check_snapshots() {
    local name="$1" url="$2" newest last
    newest=$(newest_snapshot "$url")
    if [ $(( $(date +%s) - ${newest:-0} )) -gt "$stale_after" ]; then
        if [ -n "$newest" ]; then last="The newest snapshot is from $(when "$newest")."; else last="There is no snapshot yet."; fi
        raise_alert "$name" "Backup stale: ${name}" "No backup of \`${name}\` has reached its repository for more than {{ backup_check.stale_after_hours }} hours. ${last}

Look at the backup container's log on the source. Resolved by itself when the next snapshot arrives."
    else
        resolve_alert "$name" "A new snapshot arrived."
    fi
}

# The source uploads restore-test.passed or .failed next to the repository
# after each restore test (restic-backup role).
check_restore_test() {
    local name="$1" url="${2%/}" max_days="$3" passed failed problem last
    passed=$(modified "${url}/restore-test.passed")
    failed=$(modified "${url}/restore-test.failed")
    if [ "${failed:-0}" -gt "${passed:-0}" ]; then
        problem="The last restore test of \`${name}\` failed, at $(when "$failed")."
    elif [ $(( $(date +%s) - ${passed:-0} )) -gt $(( max_days * 86400 )) ]; then
        if [ -n "$passed" ]; then last="The last one passed at $(when "$passed")."; else last="None has passed yet."; fi
        problem="No restore test of \`${name}\` has passed for more than ${max_days} days. ${last}"
    fi
    if [ -n "${problem:-}" ]; then
        raise_alert "${name}-restore-test" "Restore test: ${name}" "${problem}

Its log is log/restore-test.log in the backup directory on the source; \`kayra backup test ${name}\` runs one by hand and follows it. Resolved by itself when the next one passes."
    else
        resolve_alert "${name}-restore-test" "A restore test passed."
    fi
}

{% for repository in backup_check.repositories %}
check_snapshots {{ repository.name | quote }} {{ repository.url | quote }}
{% if repository.restore_test_max_days is defined %}
check_restore_test {{ repository.name | quote }} {{ repository.url | quote }} {{ repository.restore_test_max_days | int }}
{% endif %}
{% endfor %}
