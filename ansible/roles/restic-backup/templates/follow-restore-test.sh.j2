#!/bin/sh
# Generated by Ansible (restic-backup role). Follows the restore test that is
# running, or about to: its log until it ends, then exits with its status.
# Runs on the host as the operator's SSH user (kayra backup test), so it reads
# only log/. Stopping it leaves the restore test running.
set -eu

log='{{ restic_backup.dir }}/log'
lock="${log}/restore-test.lock"

# A test that runs holds the lock, and removed the last one's status only
# after starting its log. It was just started, so wait for that.
waited=0
until [ -e "$lock" ] && ! flock -n "$lock" true && [ ! -e "${log}/restore-test.status" ]; do
    if [ "$waited" -ge 30 ]; then
        echo "No restore test started; its first lines go to the backup container's log." >&2
        exit 1
    fi
    waited=$((waited + 1))
    sleep 1
done

tail -n +1 -F "${log}/restore-test.log" &
follower=$!
flock "$lock" true
sleep 1
kill "$follower"
exit "$(cat "${log}/restore-test.status")"
