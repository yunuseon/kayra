{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "One PR for all Jenkins plugins: they are released and tested as a set",
      "matchManagers": [
        "jenkins"
      ],
      "groupName": "Jenkins plugins"
    }
  ]
}
