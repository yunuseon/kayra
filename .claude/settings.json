{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent/guard.sh\"",
            "onFailure": "block",
            "statusMessage": "kayra guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Edit(.claude/**)",
      "Edit(scripts/agent/**)",
      "Edit(.github/CODEOWNERS)"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
