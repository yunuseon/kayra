# Generated by Ansible (restic-backup role): the SFTP target, as the
# repository's host alias `backup-target`.
Host backup-target
	HostName {{ restic_backup.ssh.host }}
	User {{ restic_backup.ssh.user }}
	Port {{ restic_backup.ssh.port | default(22) }}
	IdentityFile /root/.ssh/id_ed25519
	IdentitiesOnly yes
	# The host key is pinned in known_hosts; nothing else is trusted.
	StrictHostKeyChecking yes
	UserKnownHostsFile /root/.ssh/known_hosts
	ServerAliveInterval 60
