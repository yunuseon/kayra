{#- Rendered once per app by the platform app role. The jobs run the platform
    library's pipelines; the app's repo is only ever checked out as data. -#}
{% set coords = {
  'name': app.name, 'repo': app_repo, 'ref': app_ref, 'path': app.path | default('.'),
  'hosts': manifest.subdomains | map('regex_replace', '$', '.' ~ domain) | list,
  'secrets': manifest.secrets | default([]),
} -%}
{% set literal = coords | to_json | regex_replace('^\\{', '[') | regex_replace('\\}$', ']') | regex_replace('"(\\w+)": ', '\\1: ') %}
# =============================================================================
# {{ app.name }} — generated by the platform app role. Do not edit on the server.
# =============================================================================

credentials:
  system:
    domainCredentials:
      - credentials:
{% for key in manifest.secrets | default([]) %}
          - string:
              scope: GLOBAL
              id: "{{ app.name }}-{{ key | lower | replace('_', '-') }}"
              description: "{{ app.name }}: {{ key }}"
              secret: "${readFile:/run/app-secrets/{{ app.name }}/{{ key }}}"
{% endfor %}

jobs:
  - script: |
      folder("{{ app.name }}") {
        displayName("{{ app.name }}")
      }

      pipelineJob("{{ app.name }}/build") {
        displayName("Build")
        description("Builds {{ app.name }}'s images from {{ app_ref }} on every push (GitHub webhook, hourly poll as fallback); any other branch on demand. A green {{ app_ref }} build deploys that exact commit.")
        logRotator { numToKeep(20) }
        // Declared here as well as in the pipeline: a JCasC reload regenerates
        // the job from this DSL, and parameters only the pipeline declared
        // would be gone — Jenkins then silently drops the ones passed in.
        parameters {
          stringParam("BRANCH", "{{ app_ref }}", "Branch, tag or commit to build")
        }
        definition {
          cps {
            script('''@Library('platform') _
      appBuild({{ literal }})''')
            sandbox(true)
          }
        }
        triggers {
          githubPush()
          scm("H * * * *")
        }
      }

      pipelineJob("{{ app.name }}/deploy") {
        displayName("Deploy")
        description("Deploys any branch, tag or commit of {{ app.name }}: builds missing images, admits the compose config against the platform policy, runs it, records the release. Rollback starts it with an older SHA.")
        logRotator { numToKeep(50) }
        parameters {
          stringParam("REF", "{{ app_ref }}", "Branch, tag or commit SHA to deploy")
        }
        definition {
          cps {
            script('''@Library('platform') _
      appDeploy({{ literal }})''')
            sandbox(true)
          }
        }
      }
