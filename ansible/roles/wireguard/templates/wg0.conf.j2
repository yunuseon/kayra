# Generated by Ansible from servers/<server>/vars.yml (network) and secrets.yml
# (keys). Do not edit here.
[Interface]
Address = {{ wireguard.address }}
ListenPort = {{ wireguard.port }}
PrivateKey = {{ wireguard_private_key }}

[Peer]
PublicKey = {{ wireguard.peer_public_key }}
PresharedKey = {{ wireguard_peer_psk }}
AllowedIPs = {{ wireguard.peer_allowed_ips | join(', ') }}
PersistentKeepalive = {{ wireguard.keepalive }}
