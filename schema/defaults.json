{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "acme_email": {
      "type": "string",
      "description": "The Let's Encrypt account contact: expiry warnings land here."
    },
    "docker_version": {
      "type": "string",
      "description": "The Docker CE major the docker role pins and holds, as an apt version glob (default 5:29*)."
    },
    "authelia_policy": {
      "type": "string",
      "enum": [
        "one_factor",
        "two_factor"
      ],
      "description": "What Authelia asks of staff: two_factor (default) or one_factor."
    },
    "authelia_smtp_address": {
      "type": "string",
      "description": "SMTP server for Authelia's mails (passkey enrolment); empty: mails go to a file."
    },
    "authelia_smtp_username": {
      "type": "string",
      "description": "SMTP user for Authelia."
    },
    "authelia_smtp_sender": {
      "type": "string",
      "description": "Sender address of Authelia's mails."
    },
    "acme_dns": {
      "type": "string",
      "enum": [
        "",
        "hetzner"
      ],
      "description": "Certificates by DNS-01 instead of HTTP-01, for a server the internet never reaches: the DNS provider (hetzner)."
    },
    "apex_redirect": {
      "description": "The host the bare domain redirects to, permanently, path and query kept: www sends https://<domain>/x?y to https://www.<domain>/x?y. Unset, the bare domain is not served.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "webhooks": {
      "type": "boolean",
      "description": "Whether a push webhook may start a deploy at once: true (default) serves deploy.<domain>/hook/<app>; false serves no such endpoint, and pushes deploy by deploy_poll."
    },
    "deploy_poll": {
      "type": "string",
      "description": "When the deployer looks for pushes no webhook brought, as a five-field cron spec in the server's time (default hourly: 17 * * * *)."
    },
    "renovate_repositories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "owner/repo of the repos this server's Renovate job keeps up to date; the job runs only where the list is not empty."
    },
    "renovate_schedule": {
      "type": "string",
      "description": "When the Renovate job runs, as a five-field cron spec in the server's time (default weekly: 0 4 * * 1)."
    },
    "renovate_platform": {
      "type": "string",
      "enum": [
        "github",
        "forgejo",
        "gitlab"
      ],
      "description": "Where the repos live: github (default), forgejo or gitlab."
    },
    "renovate_endpoint": {
      "type": "string",
      "description": "With a Forgejo: its API on platform-internal, e.g. http://forgejo:3000/api/v1."
    },
    "renovate_git_url": {
      "type": "string",
      "enum": [
        "default",
        "ssh",
        "endpoint"
      ],
      "description": "How Renovate clones; endpoint with a Forgejo, so it uses the internal address."
    },
    "renovate_host_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matchHost": {
            "type": "string"
          }
        },
        "required": [
          "matchHost"
        ],
        "additionalProperties": {}
      },
      "description": "Renovate hostRules: allowInternal for a Forgejo on platform-internal, credentials for a private registry."
    },
    "vm": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "disk": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "gateway",
        "disk"
      ],
      "additionalProperties": {},
      "description": "target home: the VM kayra provision builds — fixed address (CIDR), gateway, disk size."
    },
    "forgejo_config": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "container": {
          "type": "string"
        },
        "runners": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secret": {
                "type": "string"
              }
            },
            "required": [
              "user",
              "name",
              "scopes",
              "secret"
            ],
            "additionalProperties": {}
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "email"
            ],
            "additionalProperties": {}
          }
        },
        "orgs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "limited",
                  "private"
                ]
              }
            },
            "required": [
              "name",
              "owner",
              "visibility"
            ],
            "additionalProperties": {}
          }
        },
        "ssh_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            },
            "required": [
              "user",
              "title",
              "key"
            ],
            "additionalProperties": {}
          }
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "settings": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "collaborators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "string"
                    },
                    "permission": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "user",
                    "permission"
                  ],
                  "additionalProperties": {}
                }
              },
              "webhooks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "push_mirror": {
                "type": "string"
              },
              "pull_mirror": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "url",
        "container"
      ],
      "additionalProperties": {},
      "description": "What this server's own Forgejo holds, as code: users, SSH keys, organizations, runners, repos (settings, collaborators, webhooks, mirrors) and the tokens it mints for the platform."
    },
    "compose_stacks": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "stacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dir",
        "stacks"
      ],
      "additionalProperties": {},
      "description": "The server's own compose stacks: their directory on the server and the names under stacks/ to run."
    },
    "nas_root": {
      "type": "string",
      "description": "The only directory the NAS play writes in, asserted before any change (e.g. /volume2)."
    },
    "restic_backup": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "restore_test_schedule": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restore_test_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keep": {
          "type": "object",
          "properties": {
            "daily": {
              "type": "number"
            },
            "weekly": {
              "type": "number"
            },
            "monthly": {
              "type": "number"
            }
          },
          "required": [
            "daily",
            "weekly",
            "monthly"
          ],
          "additionalProperties": {}
        },
        "ssh": {
          "type": "object",
          "properties": {
            "public_key": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "port": {
              "type": "number"
            },
            "known_host": {
              "type": "string"
            }
          },
          "required": [
            "public_key",
            "host",
            "user",
            "port",
            "known_host"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "dir",
        "repository",
        "schedule",
        "restore_test_schedule",
        "paths"
      ],
      "additionalProperties": {},
      "description": "The nightly restic backup: what, where to (SFTP), when, how long kept, and the monthly restore test."
    },
    "wireguard": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "port": {
          "type": "number"
        },
        "peer_public_key": {
          "type": "string"
        },
        "peer_allowed_ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keepalive": {
          "type": "number"
        }
      },
      "required": [
        "address",
        "port",
        "peer_public_key",
        "peer_allowed_ips"
      ],
      "additionalProperties": {},
      "description": "The tunnel into the private network: the edge's address, port, and the one peer (its key, what it may reach)."
    },
    "edge_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subdomains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "upstream": {
            "type": "string"
          },
          "forwarded_headers": {
            "type": "boolean"
          }
        },
        "required": [
          "subdomains",
          "upstream"
        ],
        "additionalProperties": {}
      },
      "description": "Public names the edge serves: subdomains of the domain and the upstream inside the tunnel they go to."
    },
    "ntfy": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string"
        },
        "upstream_base_url": {
          "type": "string"
        },
        "access": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "rw",
                  "ro",
                  "wo",
                  "deny"
                ]
              }
            },
            "required": [
              "user",
              "topic",
              "permission"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "base_url",
        "access"
      ],
      "additionalProperties": {},
      "description": "An ntfy server for alerts, behind Caddy (an edge_routes entry to ntfy:80): its public base_url, who may read or publish which topic (everything else denied), and upstream_base_url (https://ntfy.sh) for iPhones, whose instant push only ntfy.sh can wake."
    },
    "monitor": {
      "type": "object",
      "properties": {
        "watch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "server": {
                "type": "string"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "watch"
      ],
      "additionalProperties": {},
      "description": "Gatus on this server, alerting through the notifier: every minute, what kayra derives for each server in watch (its logins, pages, app routes, deploy.<domain>/health; an edge's routes; certificates) with each name pinned to that server's address, plus extra checks (Gatus conditions, default [STATUS] == 200; server pins the name to that server's address)."
    },
    "notifier": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ntfy"
            },
            "url": {
              "type": "string"
            },
            "topic": {
              "type": "string",
              "pattern": "^[\\w-]{1,64}$"
            }
          },
          "required": [
            "kind",
            "url",
            "topic"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Where alerts go — the deployer's (a failed deploy of an app's ref, a failed job) and the backup check's: kind ntfy, a message to topic on the ntfy server at url when an alert opens and when it is resolved; the token in notifier_ntfy_token."
    },
    "backup_check": {
      "type": "object",
      "properties": {
        "stale_after_hours": {
          "type": "number"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "restore_test_max_days": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "url",
              "user"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "stale_after_hours",
        "repositories"
      ],
      "additionalProperties": {},
      "description": "The hourly check of the private network's backups: when a snapshot is stale, which repositories. Its alerts go to the notifier."
    }
  },
  "additionalProperties": false,
  "title": "defaults.yml"
}
