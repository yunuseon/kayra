# Generated by Ansible (restic-backup role). Output goes to the container log;
# a restore test writes its own to log/restore-test.log.
{{ restic_backup.schedule }} /etc/backup/backup.sh >/proc/1/fd/1 2>&1
{% if restic_backup.restore_test_schedule is defined %}
{{ restic_backup.restore_test_schedule }} /etc/backup/restore-test.sh >/proc/1/fd/1 2>&1
{% endif %}
