# Generated by Ansible (restic-backup role). Sourced by the scripts: cron
# jobs do not inherit the container's environment.
export PATH=/opt/restic:/usr/local/bin:/usr/bin:/bin
export RESTIC_REPOSITORY={{ restic_backup.repository | quote }}
export RESTIC_PASSWORD={{ restic_backup_password | quote }}
export RESTIC_CACHE_DIR={{ (restic_backup.dir ~ '/cache') | quote }}
{% for db in restic_backup.postgres | default([]) %}
export PG_PASSWORD_{{ db.name | upper }}={{ restic_backup_postgres_passwords[db.name] | quote }}
{% endfor %}
