{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "acme_email": {
      "type": "string",
      "description": "The Let's Encrypt account contact: expiry warnings land here."
    },
    "docker_version": {
      "type": "string",
      "description": "The Docker CE major the docker role pins and holds, as an apt version glob (default 5:29*)."
    },
    "wireguard": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "port": {
          "type": "number"
        },
        "peer_public_key": {
          "type": "string"
        },
        "peer_allowed_ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keepalive": {
          "type": "number"
        }
      },
      "required": [
        "address",
        "port",
        "peer_public_key",
        "peer_allowed_ips"
      ],
      "additionalProperties": {},
      "description": "The tunnel into the private network: the edge's address, port, and the one peer (its key, what it may reach)."
    },
    "edge_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subdomains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "upstream": {
            "type": "string"
          },
          "forwarded_headers": {
            "type": "boolean"
          }
        },
        "required": [
          "subdomains",
          "upstream"
        ],
        "additionalProperties": {}
      },
      "description": "Public names the edge serves: subdomains of the domain and the upstream inside the tunnel they go to."
    },
    "notifier": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ntfy"
            },
            "url": {
              "type": "string"
            },
            "topic": {
              "type": "string",
              "pattern": "^[\\w-]{1,64}$"
            }
          },
          "required": [
            "kind",
            "url",
            "topic"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Where alerts go — the deployer's (a failed deploy of an app's ref, a failed job) and the backup check's: kind ntfy, a message to topic on the ntfy server at url when an alert opens and when it is resolved; the token in notifier_ntfy_token."
    },
    "backup_check": {
      "type": "object",
      "properties": {
        "stale_after_hours": {
          "type": "number"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "restore_test_max_days": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "url",
              "user"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "stale_after_hours",
        "repositories"
      ],
      "additionalProperties": {},
      "description": "The hourly check of the private network's backups: when a snapshot is stale, which repositories. Its alerts go to the notifier."
    }
  },
  "additionalProperties": false,
  "title": "vars.yml (kind edge)"
}
