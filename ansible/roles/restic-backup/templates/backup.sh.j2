#!/bin/sh
# Generated by Ansible (restic-backup role). Run by cron in the backup
# container: dump the databases, back everything up, and on Sundays forget
# and prune what restic_backup.keep no longer covers (where it is set; an
# append-only repository is pruned on the receiving side instead).
set -eu
. /etc/backup/backup.env

dumps='{{ restic_backup.dir }}/dumps'
{% for db in restic_backup.postgres | default([]) %}
PGPASSWORD="$PG_PASSWORD_{{ db.name | upper }}" pg_dump --format=custom \
    --host={{ db.host }} --username={{ db.user }} --dbname={{ db.database }} \
    --file="${dumps}/{{ db.name }}.dump.tmp"
# UGOS's ACLs override the umask: new files would be world-readable.
chmod 600 "${dumps}/{{ db.name }}.dump.tmp"
mv "${dumps}/{{ db.name }}.dump.tmp" "${dumps}/{{ db.name }}.dump"
{% endfor %}

restic cat config >/dev/null 2>&1 || restic init
restic backup --host '{{ inventory_hostname }}' --exclude-file /etc/backup/excludes.txt \
    {{ restic_backup.paths | map('quote') | join(' ') }}
{% if restic_backup.keep is defined %}

if [ "$(date +%u)" = 7 ]; then
    restic forget --prune --host '{{ inventory_hostname }}'{% for period, count in restic_backup.keep.items() %} --keep-{{ period }} {{ count }}{% endfor %}

fi
{% endif %}
